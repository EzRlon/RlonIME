  "hotkeys": {
    "translate_selection": "ctrl+alt+q",
    "mark_correction": "ctrl+alt+w",
    "toggle_panel": "ctrl+alt+e",
    "cycle_scope": "ctrl+alt+a",
    "toggle_llm": "ctrl+alt+s"
  },
  "ranking": {
    "scene_match_bonus": 30,
    "profession_match_bonus": 20,
    "history_bonus_per_use": 5,
    "history_bonus_cap": 40,
    "frequency_weight": 0.35,
    "custom_word_bonus": 50,
    "max_candidates": 27,
    "rec_badge_margin": 8.0
  },
