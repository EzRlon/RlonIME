    "caret_follow": true,
    "chars_per_page": 9,
    "cad_passthrough": true,
    "cad_processes": [
      "acad.exe",
      "acadlt.exe",
      "zwcad.exe",
      "gcad.exe",
      "bricscad.exe",
      "caxa.exe",
