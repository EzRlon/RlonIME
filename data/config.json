    "panel_width": 560,
    "row_height": 38,
    "max_visible_rows": 5,
    "font_size": 15,
    "font_size_zh": 11,
    "font_size_en": 9,
    "font_family": "Microsoft YaHei UI",
    "opacity": 0.99,
    "theme": "light",
    "show_english": true,
    "show_scene_hint": true,
    "layout": "bar",
    "bar_width": 560,
    "bar_pinned": false,
    "bar_pos": [],
